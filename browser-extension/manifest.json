{
  "manifest_version": 3,
  "name": "Neptun TOTP Autofill",
  "version": "2.0",
  "description": "Autofills the Neptun 2FA one-time code from a passphrase-encrypted TOTP secret.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://neptun-hweb.sze.hu/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://neptun-hweb.sze.hu/*"],
      "js": ["totp.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}

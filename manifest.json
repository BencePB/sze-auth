{
  "manifest_version": 3,
  "name": "Neptun TOTP Autofill",
  "version": "1.0",
  "description": "Autofills the Neptun 2FA one-time code using a locally stored TOTP secret.",
  "permissions": ["storage"],
  "host_permissions": ["https://neptun-hweb.sze.hu/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://neptun-hweb.sze.hu/*"],
      "js": ["totp.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
